phpdbg: do not write into the compiled-in PHP_INI_SCAN_DIR default

phpdbg_init() splits the scan dir list at ':' by writing NUL bytes into it.
Without PHP_INI_SCAN_DIR in the environment the list is the string literal
PHP_CONFIG_FILE_SCAN_DIR, which lives in read-only memory, so a
--with-config-file-scan-dir with more than one directory crashes phpdbg on
every start. Unfixed upstream as of php-src master (2026-09-29).

--- a/sapi/phpdbg/phpdbg_prompt.c	2026-09-29 16:48:06.229915067 +0300
+++ b/sapi/phpdbg/phpdbg_prompt.c	2026-09-29 16:48:06.261591278 +0300
@@ -343,6 +343,7 @@
 		phpdbg_try_file_init(init_file, init_file_len, 1);
 	} else if (use_default) {
 		char *scan_dir = getenv("PHP_INI_SCAN_DIR");
+		char *scan_dir_copy;
 		char *sys_ini;
 		int i;
 
@@ -353,6 +354,9 @@
 		if (!scan_dir) {
 			scan_dir = PHP_CONFIG_FILE_SCAN_DIR;
 		}
+		/* The loop cuts the list up in place, so it works on a copy: the
+		 * default is a string literal in read-only memory. */
+		scan_dir = scan_dir_copy = strdup(scan_dir);
 		while (*scan_dir != 0) {
 			i = 0;
 			while (scan_dir[i] != ':') {
@@ -373,6 +377,7 @@
 			}
 			scan_dir += i + 1;
 		}
+		free(scan_dir_copy);
 
 		phpdbg_try_file_init(PHPDBG_STRL(PHPDBG_INIT_FILENAME), 0);
 	}
